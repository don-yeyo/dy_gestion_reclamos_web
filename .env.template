# ==============================================================================
# CONFIGURACIÓN GENERAL DEL MONOREPO (Don Yeyo S.A. - Gestión de Reclamos)
# ==============================================================================

# Entorno: development | production
NODE_ENV=development

# ------------------------------------------------------------------------------
# SERVIDOR BACKEND (server/.env)
# ------------------------------------------------------------------------------
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Clave secreta para firma de tokens JWT y Action Tokens HMAC (Seguridad Anti-Tampering)
# IMPORTANTE: Usar un string aleatorio y seguro de al menos 32 caracteres en producción
APP_SECRET="dy_secret_reclamos_super_seguro_2026_cambiar_en_produccion"

# Corte de numeración para el gestor: sólo se mostrarán y gestionarán reclamos >= a este ID
# Ej: 20233357
RECLAMOS_NUMERO_CORTE="20233357"

# Integración con Google Sheets (Cuenta de Servicio)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH="credentials/reclamos-service-account.json"
GOOGLE_SHEETS_SPREADSHEET_ID="1mIfYKCbjkTcNJM9Uek_DGgogVL8nXPhkfHXN4szV-S4"
GOOGLE_SHEETS_TAB_NAME="Reclamos 2023"

# Configuración SMTP para envío de emails de notificación y seguimiento
SMTP_HOST="mail.donyeyo.com.ar"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="notificaciones@donyeyo.com.ar"
SMTP_PASS="tu_contraseña_aqui"
SMTP_FROM_NAME="Gestión de Reclamos - Don Yeyo S.A."
SMTP_FROM_EMAIL="notificaciones@donyeyo.com.ar"

# Destinatarios de Workflow y Elevación (permitir varias casillas separadas por comas)
EMAILS_ADMINS="administracion@donyeyo.com.ar"
EMAILS_ELEVACION="calidad@donyeyo.com.ar,gerencia@donyeyo.com.ar"
EMAILS_INOCUIDAD="inocuidad@donyeyo.com.ar"

# Parámetros del Cron de Seguimiento Automático
# N: Días transcurridos desde aprobación para enviar email de consulta al supervisor
CRON_SUPERVISOR_DIAS_CONSULTA=5
# M / O: Días de periodicidad para reintento de consulta al supervisor si no responde
CRON_SUPERVISOR_DIAS_REINTENTO=2
# P: Cantidad máxima de reintentos antes de pasar a "Sin respuesta" y notificar a EMAILS_ELEVACION
CRON_SUPERVISOR_MAX_REINTENTOS=3
# F: Días transcurridos desde que el supervisor marca "Resuelto" para consultar al consumidor
CRON_CONSUMIDOR_DIAS_CONSULTA=3
# Días para seguimiento de inocuidad
CRON_INOCUIDAD_DIAS_CONSULTA=5

# ------------------------------------------------------------------------------
# CLIENTE FRONTEND (client/.env)
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:3001/api"

# Microsoft Azure AD / Entra ID (SSO Oficial Don Yeyo)
VITE_AZURE_AD_CLIENT_ID="9e6a0d24-3f82-416b-a255-a08b6db4f14a"
VITE_AZURE_AD_TENANT_ID="common"

# Bypass de autenticación para desarrollo local (Mock Auth)
# Poner en true únicamente para probar en entorno local sin conexión a Azure
VITE_MOCK_AUTH=false
VITE_MOCK_AUTH_EMAIL="administracion@donyeyo.com.ar"
VITE_MOCK_AUTH_NAME="Administrador Mock"
