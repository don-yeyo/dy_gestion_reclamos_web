# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DEL CLIENTE - DON YEYO S.A.
# ==============================================================================

# URL base de la API backend (local: http://localhost:3001/api, producción: /api)
VITE_API_URL=http://localhost:3001/api

# Identificador de Cliente (Application Client ID) de Microsoft Entra ID
VITE_AZURE_AD_CLIENT_ID=tu_azure_client_id_aqui

# Identificador de Directorio (Directory Tenant ID) de Office 365
VITE_AZURE_AD_TENANT_ID=tu_azure_tenant_id_aqui

# Habilitar autenticación Mock para testing local sin credenciales de Microsoft (true / false)
VITE_MOCK_AUTH=false

# Datos del usuario mock en caso de activar VITE_MOCK_AUTH=true
VITE_MOCK_AUTH_EMAIL=admin@ejemplo.com
VITE_MOCK_AUTH_NAME=Usuario Mock

# Configuración institucional
VITE_COMPANY_NAME=DON YEYO S.A.
VITE_APP_NAME="Gestión de Reclamos Web"
VITE_APP_VERSION=1.0.0
