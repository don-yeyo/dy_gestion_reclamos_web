# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DEL SERVIDOR DE GESTIÓN - DON YEYO S.A.
# ==============================================================================

# Puerto de escucha del servidor Express local
PORT=3001

# Entorno de ejecución (development / production)
NODE_ENV=development

# Clave secreta para la firma y verificación de tokens JWT y tokens HMAC de acción
APP_SECRET=tu_clave_secreta_aqui_para_produccion

# Configuración de Base de Datos MySQL (AWS RDS / On-Premise)
DB_HOST=dydb2-instance-1.cz8kik28igwg.us-east-1.rds.amazonaws.com
DB_NAME=Reclamos
DB_USER=tu_usuario_db
DB_PASS=tu_password_db
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# URL base pública de la API REST (para generación de enlaces directos en emails)
API_BASE_URL=http://localhost:3001

# URL base pública de la aplicación Web Frontend
APP_BASE_URL=http://localhost:5173

# Identificador de la hoja de cálculo de Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=tu_spreadsheet_id_aqui

# Nombre de la pestaña de reclamos en Google Sheets
GOOGLE_SHEETS_TAB_NAME="Reclamos 2023"

# Credenciales de Google Sheets:
# Opción A (Local): Ruta relativa o absoluta al archivo JSON de credenciales de la cuenta de servicio
GOOGLE_SERVICE_ACCOUNT_JSON_PATH="credentials/reclamos-501813-311b1979c9e5.json"

# Opción B (Netlify Serverless - Recomendado): Se leen automáticamente desde la tabla `config_sistema` en MySQL (clave: 'google_service_account').
# Esto evita exceder el límite de 4KB de variables de entorno de AWS Lambda en Netlify.
# Opción C (Fallback): Contenido del JSON en variable de entorno (string o Base64)
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIs...

# Número de corte de reclamos (Solo se gestionan reclamos cuyo ID >= RECLAMOS_NUMERO_CORTE)
RECLAMOS_NUMERO_CORTE=20233357

# Lista de correos con rol de Administrador autorizados a aprobar/desaprobar (separados por coma)
EMAILS_ADMINS=admin@ejemplo.com

# Lista de correos con rol de Inocuidad y Calidad (separados por coma)
EMAILS_INOCUIDAD=calidad@ejemplo.com

# Lista de correos para alertas de elevación automática por falta de respuesta (separados por coma)
EMAILS_ELEVACION=gerencia@ejemplo.com

# Configuración de Servidor SMTP Saliente para Consumidores (Notificaciones y Encuestas a Clientes)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=tu_password_smtp_aqui
SMTP_FROM_NAME="Don Yeyo - Reclamos"
SMTP_FROM_EMAIL=usuario@ejemplo.com

# Configuración de Servidor SMTP para Alertas y Correos Internos a la Empresa (Supervisores, Calidad, Admins, Elevación)
ALERTA_SMTP_HOST="smtp-mail.outlook.com"
ALERTA_SMTP_PORT=587
ALERTA_SMTP_USER="usuario@donyeyo.com.ar"
ALERTA_SMTP_PASSWORD="tu_password_o_app_password_aqui"
ALERTA_SMTP_NAME="Gabriel Tonelli"
ALERTA_SMTP_ENCRYPT="tls"

# Modo de Pruebas / Testing de Correos (Seguridad para no enviar correos a personas reales en testing)
# Si EMAIL_TEST_MODE=true, todos los correos del sistema (supervisores, calidad, consumidores, admins)
# son interceptados y redirigidos exclusivamente a la casilla configurada en EMAIL_TEST_RECIPIENT.
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=testing-reclamos@donyeyo.com.ar

# Logotipo institucional para emails y vistas públicas (URL absoluta HTTPS).
# Se configura de forma dinámica y editable desde el Gestor Web en /configuracion/parametros.
# Si se deja vacío o no se define, se toma desde la tabla config_sistema ('email_logo_url')
# o como fallback se muestra el nombre en texto 'DON YEYO'.
EMAIL_LOGO_URL=https://www.donyeyo.com.ar/logo.png

# ==============================================================================
# NOTA: Los plazos y frecuencias de recordatorio para Supervisores, Consumidores
# e Inocuidad ya no se configuran por variables de entorno estáticas, sino que se
# gestionan de forma dinámica en la Base de Datos (sección Reglas de Seguimiento
# y Configuración del Sistema).
# ==============================================================================

# ==============================================================================
# CONTROL DE TAREA PROGRAMADA / CRON SERVERLESS (NETLIFY SCHEDULED FUNCTION)
# ==============================================================================
# Flag maestro para activar o desactivar por completo la ejecución del cron (true/false)
# Si es false, la función programada aborta de inmediato sin ejecutar consultas ni enviar correos.
CRON_FOLLOWUP_ENABLED=true

# Horas específicas de ejecución en horario de Argentina (UTC-3), separadas por coma.
# Ejemplos: "9,16" (se ejecuta a las 9:00 y a las 16:00 hs), "10" (una sola vez), "9,13,17" (tres veces).
# Si se deja vacío, se ejecutará en cada disparo programado de Netlify.
CRON_HORAS_EJECUCION_ARG="9,16"
