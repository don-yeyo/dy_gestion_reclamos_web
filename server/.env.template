# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DEL SERVIDOR DE GESTIÓN - DON YEYO S.A.
# ==============================================================================

# Puerto de escucha del servidor Express local
PORT=3001

# Entorno de ejecución (development / production)
NODE_ENV=development

# Clave secreta para la firma y verificación de tokens JWT y tokens HMAC de acción
APP_SECRET=tu_clave_secreta_aqui_para_produccion

# URL base pública de la API REST (para generación de enlaces directos en emails)
API_BASE_URL=http://localhost:3001

# URL base pública de la aplicación Web Frontend
APP_BASE_URL=http://localhost:5173

# Identificador de la hoja de cálculo de Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=tu_spreadsheet_id_aqui

# Nombre de la pestaña de reclamos en Google Sheets
GOOGLE_SHEETS_TAB_NAME="Reclamos 2023"

# Credenciales de Google Sheets:
# Opción A (Local): Ruta relativa o absoluta al archivo JSON de credenciales de la cuenta de servicio
GOOGLE_SERVICE_ACCOUNT_JSON_PATH="credentials/reclamos-501813-311b1979c9e5.json"

# Opción B (Netlify / Producción Serverless): Contenido completo del archivo JSON como string o Base64
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIs...

# Número de corte de reclamos (Solo se gestionan reclamos cuyo ID >= RECLAMOS_NUMERO_CORTE)
RECLAMOS_NUMERO_CORTE=20233357

# Lista de correos con rol de Administrador autorizados a aprobar/desaprobar (separados por coma)
EMAILS_ADMINS=admin@ejemplo.com

# Lista de correos con rol de Inocuidad y Calidad (separados por coma)
EMAILS_INOCUIDAD=calidad@ejemplo.com

# Lista de correos para alertas de elevación automática por falta de respuesta (separados por coma)
EMAILS_ELEVACION=gerencia@ejemplo.com

# Configuración de Servidor SMTP saliente
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=tu_password_smtp_aqui
SMTP_FROM_NAME="Don Yeyo - Reclamos"
SMTP_FROM_EMAIL=usuario@ejemplo.com

# Configuración de días para el Cron de Seguimiento
# N: Días de espera antes del primer recordatorio al supervisor tras la aprobación
CRON_SUPERVISOR_DIAS_CONSULTA=5
# M: Frecuencia en días de los recordatorios subsiguientes
CRON_SUPERVISOR_DIAS_REINTENTO=2
# O: Cantidad máxima de reintentos antes de elevar a gerencia
CRON_SUPERVISOR_MAX_REINTENTOS=3
# P: Días tras la resolución del supervisor para consultar satisfacción al consumidor
CRON_CONSUMIDOR_DIAS_CONSULTA=3
# F: Días de seguimiento para dictamen técnico de inocuidad
CRON_INOCUIDAD_DIAS_CONSULTA=5
